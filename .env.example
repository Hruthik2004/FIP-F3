# Copy this file to .env and fill in your values
# For local development: cp .env.example .env

# ─── Vite (Frontend) ──────────────────────────────────────────────────────────
# Google OAuth Client ID (from console.google.com → APIs → Credentials)
# Leave empty to use demo/simulation mode
VITE_GOOGLE_CLIENT_ID=

# Backend API URL (if you deploy the Python backend separately on Railway)
# Leave empty to use client-side only mode
VITE_API_URL=
